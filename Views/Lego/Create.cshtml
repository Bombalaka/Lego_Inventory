@model Lego_Inventory.Models.Legoset

<h2>➕ Add a New LEGO Set</h2>

<form asp-controller="Lego" asp-action="SaveNewLegoSet" method="post" class="card p-4 shadow-lg">
    <div class="form-group" class="mb-3">
        <label asp-for="Name" class="form-label">LEGO Set Name</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="class="mb-3">
        <label asp-for="Description" class="form-label">Description</label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-success w-100 mt-3">✅ Save LEGO Set</button>
</form>